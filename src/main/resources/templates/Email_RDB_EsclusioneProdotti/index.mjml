<mjml lang="it">
  <mj-head>
    <mj-title>Notifica di esclusione prodotto - Registro dei beni</mj-title>
    <mj-font name="Titillium Web" href="https://selfcare.pagopa.it/assets/font/selfhostedfonts.css" />
    <mj-attributes>
      <mj-all font-family="Titillium Web, Arial" />
    </mj-attributes>
    <mj-raw>
      <style type="text/css">
        h1 {
          font-size: 32px;
          line-height: 40px;
          color: #17324D;
          font-weight: 700;
          text-align: left;
          margin-top: 0px;
          margin-bottom: 8px;
        }

        h4 {
          margin-bottom: 0px;
        }

        p {
          margin-top: 0px;
        }
      </style>
      <style type="text/css">
        @media (min-width:600px) {
          body {
            background-color: #E6E9F2;
          }

          .mobile {
            display: none;
          }

          .desktop {
            display: block;
          }
        }
      </style>
    </mj-raw>
  </mj-head>
  <mj-body>
    <mj-wrapper>
      <mj-section background-color="#ffffff" border-left="solid 1px #E6E9F2" border-right="solid 1px #E6E9F2" padding-bottom="0px">
        <mj-column>
          <mj-spacer height="32px" css-class="spaziatura" />
          <mj-text padding-bottom="0px">
            <mj-raw>
              <img src="https://selfcare.pagopa.it/assets/logo_pagopacorp.png" alt="Logo di PagoPA S.p.A." class="logopagopa" width="116" align="left" style="display:block;width:116px;" />
            </mj-raw>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Titolo e sottotitolo -->
      <mj-section background-color="#ffffff" border-left="solid 1px #E6E9F2" border-right="solid 1px #E6E9F2" padding-top="12px" padding-bottom="10px">
        <mj-column>
          <mj-text color="#17324D" font-weight="bold" align="left" css-class="titolo" padding-bottom="4px">
            <h1 style="font-size:32px; line-height:40px;">Registro dei beni: alcuni prodotti<br />non hanno superato il controllo</h1>
          </mj-text>

          <mj-text font-size="16px" line-height="24px" color="#17324D" font-weight="400" align="left" css-class="intro">
            <p style="margin-bottom: 8px;">Ciao,</p>
            <p style="margin-bottom: 12px;">a seguito dei controlli effettuati da Invitalia, uno o più prodotti associati<br />al tuo account nel Registro dei beni sono stati esclusi.</p>
            <p style="margin-bottom: 8px;">I prodotti che non hanno superato il controllo sono:</p>
            <ul style="margin-top: 0px; margin-bottom: 16px;">
              ${excludedList}
            </ul>
            <p style="margin-bottom: 4px;">La motivazione è:</p>
            <mj-raw>
              <pre style="font-family: 'Titillium Web', Arial, sans-serif; font-size: 16px; line-height: 24px; color: #17324D; margin: 0 0 16px 0; white-space: pre-wrap; word-break: break-word;">${formalMotivation}</pre>
            </mj-raw>
            <p style="margin-bottom: 12px;">Per maggiori dettagli, <a href="https://eie.cstar.pagopa.it/elenco-informatico-elettrodomestici" style="color: #0073E6;">accedi al portale</a>.</p>
          </mj-text>

          <mj-text font-size="16px" line-height="24px" color="#17324D" padding-top="0px">
            <p style="margin-bottom: 12px;">Hai problemi tecnici o domande? Scrivi a<br><a href="mailto:portale.bonus@registrodeibeni.it" style="color: #0073E6;">portale.bonus@registrodeibeni.it</a></p>
          </mj-text>

          <mj-text font-size="16px" line-height="24px" color="#17324D" padding-top="0px">
            <p style="margin-bottom: 0px;">A presto,<br aria-hidden="true">il team di PagoPA</p>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" border-left="solid 1px #E6E9F2" border-right="solid 1px #E6E9F2" padding-top="0px" padding-bottom="24px">
        <mj-column>
          <mj-divider border-width="1px" border-style="solid" border-color="#E6E9F2" padding-top="10px" padding-bottom="15px" />
          <mj-text font-size="13px" line-height="18px" color="#5C6F82">
            <p style="margin: 0;">Ricevi questo messaggio perché hai un’utenza attiva nel Portale Registro dei Beni.</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
