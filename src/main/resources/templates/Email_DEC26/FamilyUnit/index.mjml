<mjml lang="it">
    <mj-head>
        <mj-title>Il bonus è stato già richiesto</mj-title>

        <mj-font
            name="Titillium Web"
            href="https://selfcare.pagopa.it/assets/font/selfhostedfonts.css"
        />

        <mj-attributes>
            <mj-all font-family="Titillium Web, Arial" />
        </mj-attributes>

        <mj-raw>
            <style type="text/css">
                h1 {
                    font-size: 32px;
                    line-height: 40px;
                    color: #17324D;
                    font-weight: 700;
                    text-align: left;
                }

                h4 {
                    margin-bottom: 0px;
                }

                p {
                    margin-top: 0px;
                }
            </style>

            <style type="text/css">
                @media (min-width:600px) {
                    body {
                        background-color: #ffffff;
                    }

                    .mobile {
                        display: none;
                    }

                    .desktop {
                        display: block;
                    }
                }
            </style>
        </mj-raw>
    </mj-head>

    <mj-body>
        <mj-wrapper>
           <!-- vuoto sopra
            <mj-section>
              <mj-column>
                <mj-spacer height="32px" />
              </mj-column>
            </mj-section>-->
            <!-- Logo -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>
                    <mj-spacer height="48px" css-class="spaziatura" />

                    <mj-text>
                        <mj-raw>
                            <img
                                src="https://assets.cdn.io.pagopa.it/logos/organizations/97532760580.png"
                                alt="Logo del Ministero delle Imprese e del Made in Italy"
                                width="80"
                                align="left"
                                style="display:block;width:80px;margin-bottom:0!important"
                            />
                        </mj-raw>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Titolo e sottotitolo -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>

                    <mj-text
                        color="#17324D"
                        font-weight="bold"
                        align="left"
                        css-class="titolo"
                    >
                        <h1 style="font-size:32px; line-height:40px;">
                            Il bonus è stato già richiesto
                        </h1>
                    </mj-text>

                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#17324D"
                        font-weight="400"
                        align="left"
                        css-class="intro"
                    >
                        <p>Ciao ${name},</p>

                        <p>
                            La tua richiesta per il Bonus Decoder non può essere elaborata.
                            Un'altra persona che fa parte della tua famiglia ha già presentato richiesta.
                        </p>

                        <p>
                            È possibile inviare
                            <b>una sola richiesta per ogni famiglia anagrafica.</b>
                        </p>

                        <p>
                            Per avere più dettagli sui requisiti del bonus,
                            <a
                                href="https://www.pagopa.it/it/prodotti-e-servizi/pari/"
                                style="color:#0073E6; font-weight:600;"
                            >
                                leggi come fare.
                            </a>
                        </p>
                    </mj-text>

                </mj-column>
            </mj-section>

            <!-- Separatore -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
                padding-bottom="0"
            >
                <mj-column>
                    <mj-divider
                        border-width="1px"
                        border-color="#E6E9F2"
                        padding="0 25px"
                    />
                </mj-column>
            </mj-section>

            <!-- Footer -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>

                    <mj-spacer height="8px" css-class="spaziatura" />

                    <mj-text
                        font-size="12px"
                        line-height="16px"
                        color="#5C6F82"
                    >
                        <p style="margin-bottom:0;">
                            Ricevi questa comunicazione perché hai richiesto il Bonus Decoder.
                        </p>

                        <p>
                            Per leggere l'informativa sul trattamento dei dati personali
                            <a
                                href="https://pari.pagopa.it/bonusdecoder/utente/privacy-policy"
                                style="color:#5C6F82; text-decoration:underline;"
                            >
                                premi qui
                            </a>.
                        </p>

                        <p>
                            Non rispondere a questa email: è usato solo per l'invio di comunicazioni e,
                            non essendo monitorato, non riceverai risposta.
                        </p>
                    </mj-text>

                </mj-column>
            </mj-section>

            <!-- Spazio inferiore -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>
                    <mj-spacer height="24px" css-class="spaziatura" />
                </mj-column>
            </mj-section>

        </mj-wrapper>
    </mj-body>
</mjml>
