<mjml lang="it">
    <mj-head>
        <mj-title>Il tuo bonus sta per scadere!</mj-title>

        <mj-font
            name="Titillium Web"
            href="https://selfcare.pagopa.it/assets/font/selfhostedfonts.css"
        />

        <mj-attributes>
            <mj-all font-family="Titillium Web, Arial" />
        </mj-attributes>

        <mj-raw>
            <style type="text/css">
                h1 {
                    font-size: 32px;
                    line-height: 40px;
                    color: #17324D;
                    font-weight: 700;
                    text-align: left;
                }

                h4 {
                    margin-bottom: 0px;
                }

                p {
                    margin-top: 0px;
                }
            </style>

            <style type="text/css">
                @media (min-width:600px) {
                    body {
                        background-color: #ffffff;
                    }

                    .mobile {
                        display: none;
                    }

                    .desktop {
                        display: block;
                    }
                }
            </style>
        </mj-raw>
    </mj-head>

    <mj-body>
        <mj-wrapper>

            <!-- Logo -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>
                    <mj-spacer height="48px" css-class="spaziatura" />

                    <mj-text>
                        <mj-raw>
                            <img
                                src="https://assets.cdn.io.pagopa.it/logos/organizations/97532760580.png"
                                alt="Logo del Ministero delle Imprese e del Made in Italy"
                                width="80"
                                align="left"
                                style="display:block;width:80px;margin-bottom:0!important"
                            />
                        </mj-raw>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Titolo e contenuto -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>

                    <mj-text
                        color="#17324D"
                        font-weight="bold"
                        align="left"
                        css-class="titolo"
                    >
                        <h1 style="font-size:32px; line-height:40px;">
                            Il tuo bonus sta per scadere!
                        </h1>
                    </mj-text>

                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#17324D"
                        font-weight="400"
                        align="left"
                        css-class="intro"
                    >
                        <p>Ciao ${name},</p>

                        <p>
                            hai già deciso come usare il Bonus Decoder?
                        </p>

                        <p>
                            Hai tempo
                            <b>fino alle 23:59 del giorno ${voucherEndDate}</b>
                            per usare il contributo e sostituire un vecchio elettrodomestico
                            con uno a basso consumo energetico.
                        </p>

                        <p>
                            <b>Troppo tardi?</b>
                        </p>

                        <p>
                            Se non hai fatto in tempo ad usare il bonus, puoi fare nuovamente richiesta.
                            Se ci sono ancora fondi disponibili, la richiesta verrà inserita in lista d’attesa.
                        </p>

                        <p>
                            <b>Hai domande?</b>
                        </p>

                        <p>
                            Per avere più dettagli su come e dove usare il bonus,
                            <a
                                href="https://www.pagopa.it/it/prodotti-e-servizi/pari/"
                                style="color:#0073E6;"
                            >
                                leggi la guida.
                            </a>
                        </p>
                    </mj-text>

                    <!-- CTA -->
                    <mj-button
                        background-color="#0073E6"
                        color="#ffffff"
                        font-size="16px"
                        font-weight="bold"
                        border-radius="3px"
                        align="left"
                        inner-padding="10px 25px"
                        padding-top="10px"
                        padding-bottom="16px"
                        href="https://pari.pagopa.it/bonusdecoder/utente"
                    >
                        Vai al sito
                    </mj-button>

                </mj-column>
            </mj-section>

            <!-- Separatore -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
                padding-bottom="0"
            >
                <mj-column>
                    <mj-divider
                        border-width="1px"
                        border-color="#E6E9F2"
                        padding="0 25px"
                    />
                </mj-column>
            </mj-section>

            <!-- Footer -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>

                    <mj-spacer height="8px" css-class="spaziatura" />

                    <mj-text
                        font-size="12px"
                        line-height="16px"
                        color="#5C6F82"
                    >
                        <p style="margin-bottom:0;">
                            Ricevi questa comunicazione perché hai richiesto il Bonus Decoder.
                        </p>

                        <p>
                            Per leggere l'informativa sul trattamento dei dati personali
                            <a
                                href="https://pari.pagopa.it/bonusdecoder/utente/privacy-policy"
                                style="color:#5C6F82; text-decoration:underline;"
                            >
                                premi qui
                            </a>.
                        </p>

                        <p>
                            Non rispondere a questa email: è usato solo per l'invio di comunicazioni e,
                            non essendo monitorato, non riceverai risposta.
                        </p>
                    </mj-text>

                </mj-column>
            </mj-section>

            <!-- Spazio finale -->
            <mj-section
                background-color="#ffffff"
                border-left="solid 0px #E6E9F2"
                border-right="solid 0px #E6E9F2"
            >
                <mj-column>
                    <mj-spacer height="24px" css-class="spaziatura" />
                </mj-column>
            </mj-section>

        </mj-wrapper>
    </mj-body>
</mjml>
