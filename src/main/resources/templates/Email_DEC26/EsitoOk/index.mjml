<mjml lang="it">
    <mj-head>
        <mj-title>Hai ottenuto il bonus!</mj-title>

        <mj-font
            name="Titillium Web"
            href="https://selfcare.pagopa.it/assets/font/selfhostedfonts.css"
        />

        <mj-attributes>
            <mj-all font-family="Titillium Web, Arial" />
        </mj-attributes>

        <mj-raw>
            <style type="text/css">
                h1 {
                    margin: 0;
                    font-size: 32px;
                    line-height: 40px;
                    color: #17324D;
                    font-weight: 700;
                    text-align: left;
                }

                p {
                    margin-top: 0;
                    margin-bottom: 0;
                }

                ul {
                    margin-top: 8px;
                    margin-bottom: 0;
                    padding-left: 24px;
                }

                li {
                    margin-bottom: 4px;
                }
            </style>

            <style type="text/css">
                @media (min-width:600px) {
                    body {
                        background-color: #ffffff;
                    }

                    .mobile {
                        display: none;
                    }

                    .desktop {
                        display: block;
                    }
                }
            </style>
        </mj-raw>
    </mj-head>

    <mj-body background-color="#ffffff">

        <mj-wrapper
            background-color="#ffffff"
            padding="0"
        >

            <!-- Logo -->
            <mj-section
                background-color="#ffffff"
                padding="0"
            >
                <mj-column>

                    <mj-spacer height="48px" />

                    <mj-image
                        src="https://assets.cdn.io.pagopa.it/logos/organizations/97532760580.png"
                        alt="Logo del Ministero delle Imprese e del Made in Italy"
                        width="48px"
                        align="left"
                        padding="0 25px"
                    />

                    <mj-spacer height="32px" />

                </mj-column>
            </mj-section>

            <!-- Contenuto -->
            <mj-section
                background-color="#ffffff"
                padding="0"
            >
                <mj-column>

                    <!-- Titolo -->
                    <mj-text
                        padding="0 25px"
                        align="left"
                    >
                        <h1>Hai ottenuto il bonus!</h1>
                    </mj-text>

                    <mj-spacer height="16px" />

                    <!-- Saluto -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#17324D"
                        padding="0 25px"
                    >
                        <p>Ciao ${name},</p>
                    </mj-text>

                    <mj-spacer height="24px" />

                    <!-- Conferma -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        padding="0 25px"
                    >
                        <p>Buone notizie!</p>
                        <p>Hai ottenuto il Bonus Decoder.</p>
                    </mj-text>

                    <mj-spacer height="12px" />

                    <!-- Validità voucher -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        padding="0 25px"
                    >
                        <p>
                            Il voucher sarà valido per i <b>prossimi 15 giorni</b>.
                        </p>
                    </mj-text>

                    <mj-spacer height="20px" />

                    <!-- Cosa puoi fare ora -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        font-weight="700"
                        padding="0 25px"
                    >
                        <p>Cosa puoi fare ora?</p>
                    </mj-text>

                    <mj-spacer height="8px" />

                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        padding="0 25px"
                    >
                        <p>
                            Il contributo copre fino al 70% del costo di acquisto del decoder,
                            per un importo massimo di:
                        </p>

                        <ul>
                            <li>30€ per i decoder digitali terrestri standard</li>
                            <li>70€ per i decoder satellitari.</li>
                        </ul>
                    </mj-text>

                    <mj-spacer height="20px" />

                    <!-- Come fare -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        font-weight="700"
                        padding="0 25px"
                    >
                        <p>Come fare?</p>
                    </mj-text>

                    <mj-spacer height="8px" />

                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        padding="0 25px"
                    >
                        <p>
                            Per avere più informazioni su come e dove usare il bonus,
                            <a
                                href="https://pari.pagopa.it/bonusdecoder/utente"
                                style="color:#0073E6; text-decoration:underline;"
                            >
                                leggi i dettagli</a>.
                        </p>
                    </mj-text>

                    <mj-spacer height="20px" />

                    <!-- Importante -->
                    <mj-text
                        font-size="16px"
                        line-height="24px"
                        color="#263238"
                        padding="0 25px"
                    >
                        <p>
                            <b>Importante:</b> ricorda che puoi usare il bonus una sola volta
                            per famiglia anagrafica, e solo se sei in regola con il canone RAI.
                        </p>
                    </mj-text>

                    <mj-spacer height="24px" />

                    <!-- CTA -->
                    <mj-button
                        background-color="#0073E6"
                        color="#ffffff"
                        font-size="16px"
                        font-weight="700"
                        line-height="24px"
                        border-radius="4px"
                        inner-padding="10px 24px"
                        padding="0 25px"
                        align="left"
                        href="https://pari.pagopa.it/bonusdecoder/utente"
                    >
                        Vai al sito
                    </mj-button>

                    <mj-spacer height="32px" />

                </mj-column>
            </mj-section>

            <!-- Separatore -->
            <mj-section
                background-color="#ffffff"
                padding="0"
            >
                <mj-column>

                    <mj-divider
                        border-width="1px"
                        border-style="solid"
                        border-color="#E6E9F2"
                        padding="0 25px"
                    />

                </mj-column>
            </mj-section>

            <!-- Footer -->
            <mj-section
                background-color="#ffffff"
                padding="0"
            >
                <mj-column>

                    <mj-spacer height="24px" />

                    <mj-text
                        font-size="12px"
                        line-height="16px"
                        color="#5C6F82"
                        padding="0 25px"
                    >
                        <p>
                            Ricevi questa comunicazione perché hai richiesto il Bonus Decoder.
                        </p>

                        <p>
                            Per leggere l'informativa sul trattamento dei dati personali
                            <a
                                href="https://pari.pagopa.it/bonusdecoder/utente/privacy-policy"
                                style="color:#5C6F82; text-decoration:underline;"
                            >
                                premi qui
                            </a>.
                        </p>
                    </mj-text>

                    <mj-spacer height="20px" />

                    <mj-text
                        font-size="12px"
                        line-height="16px"
                        color="#5C6F82"
                        padding="0 25px"
                    >
                        <p>
                            Non rispondere a questa email: è usato solo per l'invio di comunicazioni e,
                            non essendo monitorato, non riceverai risposta.
                        </p>
                    </mj-text>

                    <mj-spacer height="32px" />

                </mj-column>
            </mj-section>

        </mj-wrapper>

    </mj-body>
</mjml>